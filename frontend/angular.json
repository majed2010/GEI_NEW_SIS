{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json", "version": 1,
  "cli": { "analytics": false },
  "projects": { "sis": { "projectType": "application", "root": "", "sourceRoot": "src", "architect": {
    "build": { "builder": "@angular/build:application", "options": { "browser": "src/main.ts", "tsConfig": "tsconfig.app.json", "index": "src/index.html", "assets": [{ "glob": "**/*", "input": "public" }], "styles": ["src/styles.css"] }, "configurations": { "production": { "outputHashing": "all", "budgets": [{ "type": "initial", "maximumWarning": "850kB", "maximumError": "1MB" }] }, "development": { "optimization": false, "sourceMap": true } }, "defaultConfiguration": "production" },
    "serve": { "builder": "@angular/build:dev-server", "configurations": { "development": { "buildTarget": "sis:build:development", "proxyConfig": "proxy.conf.json" } }, "defaultConfiguration": "development" }
  } } }
}
